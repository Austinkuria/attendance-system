# Backend Environment Configuration Template
# Copy this file to .env and replace dummy values with your actual configuration

PORT=5000
NODE_ENV=development

# Client URLs for CORS and Email Redirection
CLIENT_URL_DEV=http://localhost:5173
CLIENT_URL_PROD=
FRONTEND_URL=

# Database Connection
MONGO_URI=

# Authentication & Security Secrets (Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=4h
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here
CSRF_SECRET=your_csrf_secret_here
QR_SECRET_KEY=your_qr_hmac_secret_key_here
SESSION_TIMEOUT=10800

# Logging
LOG_LEVEL=info

# SMTP Configuration for Transactional Emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_user@example.com
SMTP_PASS=your_smtp_app_password
